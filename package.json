{
  "name": "homepage-modules",
  "version": "2.4.1",
  "description": "一个插件塞进 30 个模块：待办看板、番茄专注、习惯打卡、FSRS 背单词、AI 助手……每个模块一个代码块即用，数据全本地，主页拖拽编排。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "wordbank": "node scripts/gen-wordbank.mjs",
    "package": "node scripts/package-release.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "dashboard",
    "homepage",
    "pomodoro",
    "habit",
    "fsrs"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.20.0",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "ts-fsrs": "^4.4.0"
  }
}
